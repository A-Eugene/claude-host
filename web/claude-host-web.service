[Unit]
Description=Claude Host web page for the claude-host fleet (127.0.0.1:3115)
After=network.target

[Service]
ExecStart=/usr/bin/python3 %h/.claude/skills/claude-host/web/server.py
WorkingDirectory=%h/.claude/skills/claude-host/web
Environment=HOME=%h
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
